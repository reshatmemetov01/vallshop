# nginx-конфиг для ПУБЛИЧНОЙ ВИТРИНЫ (сайт) на vallshop.com и vallshop.ru.
# Отдельный server-блок — не затрагивает бота (shop.vallshop.com → :8080).
# Витрина слушает 127.0.0.1:8090 (docker-compose.web.yml).
#
# Предварительно: DNS A-записи vallshop.com, www.vallshop.com, vallshop.ru,
# www.vallshop.ru должны указывать на IP этого сервера.
#
# Установка:
#   sudo cp deploy/nginx-site.conf.example /etc/nginx/sites-available/vallshop-site.conf
#   sudo ln -s /etc/nginx/sites-available/vallshop-site.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
# Затем HTTPS-сертификат на все 4 домена (certbot сам пропишет TLS и редирект 80→443):
#   sudo certbot --nginx -d vallshop.com -d www.vallshop.com -d vallshop.ru -d www.vallshop.ru
#
# На debian/ubuntu с conf.d можно положить файл в /etc/nginx/conf.d/ вместо
# sites-available/enabled.

server {
    listen 80;
    listen [::]:80;
    server_name vallshop.com www.vallshop.com vallshop.ru www.vallshop.ru;

    client_max_body_size 5m;

    # Витрина + её API (всё на контейнере сайта, localhost:8090).
    location / {
        proxy_pass http://127.0.0.1:8090;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
