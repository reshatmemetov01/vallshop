# ── Общее ────────────────────────────────────────────────────────────────────
# Скопируйте в .env и заполните. .env в .gitignore — НЕ коммитить секреты.

# ── Telegram-бот ──────────────────────────────────────────────────────────────
# Токен бота от @BotFather.
BOT_TOKEN=
# Telegram user id администраторов (через запятую) — им доступна /admin.
ADMIN_IDS=

# ── База данных ──────────────────────────────────────────────────────────────
# По умолчанию локальный SQLite. Для PostgreSQL:
#   DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/vallshop
DATABASE_URL=sqlite+aiosqlite:///vallshop.db

# ── Витрина / цены ───────────────────────────────────────────────────────────
# Валюта отображения (внутренне всё в USD ≈ USDT).
SHOP_CURRENCY=USDT
# Наценка по умолчанию, % (если у номинала не задана своя цена/наценка).
DEFAULT_MARKUP_PERCENT=0
# Цветные кнопки (style: 🟢success/🔴danger/🔵primary). 1/0.
# Если старый клиент Telegram не отрисовывает цвет — можно выключить (0).
BUTTON_STYLES=1
# Кастом-эмодзи (премиум) на кнопках. Нужен Telegram Premium у владельца бота.
# Если бот без Premium и кнопки не отправляются — выключить (0).
CUSTOM_EMOJI=1

# ── Платёжный провайдер BoltUtil (USDT) ──────────────────────────────────────
BOLT_BASE_URL=https://api.boltutil.com
# API-ключ (заголовок X-Bolt-Key), в кабинете вида bt_live_...
BOLT_API_KEY=
# Webhook Secret из кабинета — ключ HMAC-SHA256 для ВСЕХ запросов и колбэков.
BOLT_SECRET=
# Сеть по умолчанию (если список сетей ниже пуст): TRC20 | ERC20 | BEP20 | POLYGON | SOLANA.
BOLT_NETWORK=TRC20
# Сети на выбор покупателю (через запятую). Для каждой нужен активный
# settlement-кошелёк в кабинете BoltUtil. Пример: TRC20,BEP20,ERC20
BOLT_NETWORKS=TRC20
# Публичный HTTPS-URL сервиса (для notifyUrl вебхука и редиректа).
# Без него вебхук-сервер не поднимается — оплата проверяется кнопкой в боте.
PUBLIC_BASE_URL=
# Порт HTTP-сервера вебхуков.
PORT=8080
# Время жизни счёта, минут (Starter BoltUtil = 30).
PAYMENT_TIMEOUT_MINUTES=30

# Контакт поддержки (для FAQ и оферты): @username, ссылка или email.
SUPPORT_CONTACT=
# Реквизиты продавца для оферты (ИП/самозанятый/название) — опционально.
LEGAL_ENTITY=
# Mock-режим платежей (1/0) — без сети и без реальных денег, для разработки.
MOCK_PAYMENTS=0

# ── PayHot (приём ₽: карта / СБП / SberPay, docs.pay.hot) ─────────────────────
PAYHOT_BASE_URL=https://app.pay.hot/api/v2
# API-ключ проекта (заголовок Authorization: Bearer ...).
PAYHOT_API_KEY=
# Секрет подписи вебхука (проверка PayHot-Signature).
PAYHOT_SECRET=
# Способы на выбор клиенту (через запятую). Пусто = card,sbp,sberpay.
PAYHOT_METHODS=card,sbp,sberpay
# Mock-режим (1/0) — без сети, для разработки.
PAYHOT_MOCK=0
# Вебхук PayHot указывается в кабинете как: <PUBLIC_BASE_URL>/payhot/webhook

# ── Paydex (приём ₽ по СБП, paydex.pro/docs) ─────────────────────────────────
PAYDEX_BASE_URL=https://paydex.pro/api/v1
# secret_key проекта (Authorization: Bearer ...), вид sk_live_... / sk_test_...
PAYDEX_API_KEY=
# webhook_secret проекта (проверка подписи X-Paydex-Signature). Отличается от secret_key!
PAYDEX_SECRET=
# Mock-режим (1/0) — без сети, для разработки.
PAYDEX_MOCK=0
# Вебхук (webhook_url) указывается в кабинете Paydex как: <PUBLIC_BASE_URL>/paydex/webhook

# ── LioGames (поставщик) ─────────────────────────────────────────────────────
LIOG_BASE_URL=https://distribution.liogames.com/api/v1
LIOG_MEMBER_CODE=M2609247OQFNWJJ8W
LIOG_SECRET=
# LIOG_KEY_ID=
LIOG_SANDBOX=0
LIOG_MOCK=0
LIOG_PRODUCT_ID=66599
LIOG_VARIATIONS=60:534124,325:534125,660:534126,1800:534127,3850:534128,8100:534129,16200:534130,24300:534131,32400:534132,40500:534133

# ── FazerCard (поставщик, api.fzr.cards) ─────────────────────────────────────
FZR_BASE_URL=https://api.fzr.cards
# Reseller API-ключ (заголовок X-API-Key), вида fc_...
FZR_API_KEY=
# Mock-режим клиента (1/0) — без сети, для разработки.
FZR_MOCK=0

# ── SMM-панель soc-proof.su (накрутка: подписчики, просмотры, лайки) ───────────
SOCPROOF_BASE_URL=https://soc-proof.su/api/v2
# API-ключ со страницы «Аккаунт» панели (деньги/цены — в рублях).
SOCPROOF_API_KEY=
# Mock-режим клиента (1/0) — без сети, для разработки.
SOCPROOF_MOCK=0

# ── SMM-панель 1xpanel.com (второй поставщик накрутки, тот же API панелей) ─────
ONEXPANEL_BASE_URL=https://1xpanel.com/api/v2
# API-ключ со страницы «API» панели 1xpanel.
ONEXPANEL_API_KEY=
# Mock-режим клиента (1/0) — без сети, для разработки.
ONEXPANEL_MOCK=0

# ── VPNresellers (готовые VPN-серверы, api.vpnresellers.com) ──────────────────
VPNR_BASE_URL=https://api.vpnresellers.com/v4_1
# Bearer-токен из кабинета app.vpnresellers.com/api-access
VPNR_TOKEN=
# Mock-режим клиента (1/0) — без сети, для разработки.
VPNR_MOCK=0

# ── Публичный сайт (web/, отдельный деплой docker-compose.web.yml) ────────────
# Секрет для подписи JWT сайта (поставь длинную случайную строку в проде).
WEB_JWT_SECRET=change-me-in-prod
# Имя бота БЕЗ @ для кнопки «Войти через Telegram» на сайте.
# Домен сайта нужно привязать к этому боту: @BotFather → /setdomain → vallshop.com
TELEGRAM_BOT_USERNAME=
# SMTP для писем сайта (подтверждение email, сброс пароля). Пусто → письма не шлём.
SMTP_HOST=mail.hosting.reg.ru
SMTP_PORT=465
SMTP_SSL=1
SMTP_USER=noreply@vallshop.ru
SMTP_PASSWORD=
SMTP_FROM=noreply@vallshop.ru
# Отображаемое имя отправителя (получатель видит его вместо адреса).
SMTP_FROM_NAME=VallShop
